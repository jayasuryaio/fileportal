# Copy to .env for local development.
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# MySQL connection (either a single URL ...)
# DATABASE_URL=mysql://user:password@localhost:3306/fileportal
# ... or the individual parts:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fileportal
DB_PASSWORD=fileportal
DB_NAME=fileportal

# Directory where uploaded files are stored on the server
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Timezone used when displaying upload timestamps
APP_TIMEZONE=Asia/Kolkata
